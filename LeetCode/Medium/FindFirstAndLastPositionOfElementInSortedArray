class Solution {
    public int[] searchRange(int[] nums, int target) {

        //시작 인덱스 찾기
        int first = findTargetIdx(nums, target, true);

        if(first == -1) return new int[]{-1, -1};
        
        //마지막 인덱스 찾기
        int last = findTargetIdx(nums, target, false);

        return new int[]{first, last};
    }

    public int findTargetIdx(int[] nums, int target, boolean isFirst){
        int left = 0;
        int right = nums.length - 1;
        int findIdx = -1;

        while(left <= right){
            int mid = left + (right - left) / 2;

            if(nums[mid] == target){
                findIdx = mid;

                if(isFirst){ //왼쪽 방향에 target이 더 있는지 탐색
                    right = mid - 1;
                }else{ //오른쪽 방향에 target이 더 있는지 탐색
                    left = mid + 1;
                }
                
            }else if(nums[mid] < target){
                left = mid + 1;
            }else{
                right = mid - 1;
            }
        }

        return findIdx;
    }
}
