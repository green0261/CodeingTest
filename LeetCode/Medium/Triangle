class Solution {
    public int minimumTotal(List<List<Integer>> triangle) {

        int size = triangle.size();

        int[] dp = new int[size];

        //triangle 제일 마지막 row값을 배열에 넣기
        for(int i = 0 ; i < dp.length ; i++){
            dp[i] = triangle.get(size - 1).get(i);
        }

        //최소 합 계산(bottom up 방식)
        for(int i = (size - 2) ; i >= 0 ; i--){
            List<Integer> currentRow = triangle.get(i); //현재 row

            for(int j = 0 ; j <= i ; j++){
                //현재 인덱스까지의 최소값 = 현재값 + 다음 row(i+1)의 j, j+1 값 중 최소값
                dp[j] = currentRow.get(j) + Math.min(dp[j], dp[j+1]);
            }
        }
            
        return dp[0];
        
    }

}
