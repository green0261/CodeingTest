/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int postIdx;
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        postIdx = postorder.length-1;
        Map<Integer,Integer> inMap = new HashMap<>();

        for(int i = 0 ; i < inorder.length ; i++){
            inMap.put(inorder[i], i);
        }

        return go(inMap, postorder, 0, postorder.length-1);
    }

    public TreeNode go(Map<Integer,Integer> inMap, int[] post, int start, int end){
        if(start > end){
            return null;
        }

        //현재 노드 값
        int val = post[postIdx--];
    
        //inorder에서의 인덱스
        int idx = inMap.get(val);
        
        TreeNode node = new TreeNode(val);
        //오른쪽 자식 트리 탐색
        node.right = go(inMap, post, idx+1, end);

        //왼쪽 자식 트리 탐색
        node.left = go(inMap, post, start, idx-1);
        
        return node;
    }
}
